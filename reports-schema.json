{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://ietf.org/json_schemas/reports_schema.json",
  "title": "Report Summary",
  "description": "Automated Discovery of Reports",
  "type": "object",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "regs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string",
                  "format": "uri"
                },
                "not_before": {
                  "type": "string",
                  "format": "date"
                },
                "not_after": {
                  "type": "string",
                  "format": "date"
                }
              },
              "required": [
                "uri"
              ]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "property of top-level 'reports' object",
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "uris",
          "regs",
          "reports"
        ]
      }
    },
    "reports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "title": {
            "type": "string"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "date",
          "title",
          "urls"
        ]
      }
    }
  },
  "required": [
    "operations",
    "reports"
  ]
}
